#!/bin/sh
# The spoochie CLI, wherever it comes from:
#   1. the binary for THIS version, downloaded and verified by the hook: ~/.claude/spoochie/bin/spoochie-<version>
#   2. Bun running this plugin's source code
# The slash commands and the hooks go through here so the choice is made in one place.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION=$(sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$ROOT/.claude-plugin/plugin.json" | head -1)
BIN="${SPOOCHIE_HOME:-$HOME/.claude/spoochie}/bin/spoochie-$VERSION"
if [ -x "$BIN" ]; then exec "$BIN" "$@"; fi
if command -v bun >/dev/null 2>&1; then exec bun run "$ROOT/src/cli.ts" "$@"; fi
echo "spoochie: neither the verified binary ($BIN) nor Bun is available. Restart Claude Code so the hook can download it, or install Bun." >&2
exit 127
